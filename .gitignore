# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Loose gerber/drill output -- zipped into prod/*.zip instead
prod/gerbers/

# Local project settings
*.kicad_prl
pcb/ibom.config.ini

# Dokumentacja projektowa - lokalna, nie publikowana
plan/

# -----------------------------------------------------------------------------
# STM32CubeIDE / firmware — kompilaty i pliki uzytkownika IDE
# .project / .cproject / .mxproject / .settings/ sa wersjonowane (konfiguracja
# projektu potrzebna do otwarcia w CubeIDE). Obrazy wgrane na sprzet trafiaja
# do releases/ (wersjonowane wbrew regulom ponizej).
# -----------------------------------------------------------------------------
firmware/**/Debug/
firmware/**/Release/
*.elf
*.list
*.map
*.o
*.d
*.su
*.cyclo
*.bin
*.hex
!releases/
!releases/**
# Raporty badania zgodnosci (canconf) — lokalnie, poza repozytorium.
releases/raport-*/
.metadata/
RemoteSystemsTempFiles/

# Python
__pycache__/
*.pyc
